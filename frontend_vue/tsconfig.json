{
  "compilerOptions": {
    // 允许从没有默认导出的模块中默认导入（兼容一些 CommonJS 模块）
    "allowSyntheticDefaultImports": true,
    // 确保 .vue 文件的类型声明被识别（需配合 vue-tsc）
    "types": [
      "vite/client",
      "vue"
    ],
    // 禁止未使用的变量（严格模式已包含，但可单独强调）
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // 禁止在函数中缺少 return 语句导致的隐式 undefined
    "noImplicitReturns": true,
    // 支持 Vue 3 的 <script setup> 和 JSX 语法
    "jsxImportSource": "vue",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    // "module": "node16",
    // "moduleResolution": "Node16",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    // "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".", // 基础目录
    "paths": {
      "@/*": [
        "src/*"
      ] // TypeScript 编译时解析 @/* 为 src/*
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "node_modules/@icon-park/vue-next/**/*"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}